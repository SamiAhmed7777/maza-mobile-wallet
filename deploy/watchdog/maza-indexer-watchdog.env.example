# /etc/maza-indexer-watchdog.env — per-host watchdog config (deploy step
# writes this file; real values are NEVER committed). Placeholders only.
# The watchdog is single-role (the maza-indexer serving surface), so there
# is no role argument.

# Alert destination: numeric Telegram chat id. Default is the fleet default
# (Sami's DM, same audience as the bench watchdog).
MAZA_WATCHDOG_CHAT=637130179

# Telegram token source: a 0600 file containing ONLY the token on line 1
# (staged by the deploy step; never committed, never printed).
MAZA_WATCHDOG_TOKEN_FILE=/etc/maza-indexer-watchdog.token

# The indexer health URL to probe. The documented default is the loopback
# bind of the deployed indexer (127.0.0.1:18711 — the indexer's own bind
# from its env contract); override only when the bind moves.
# MAZA_INDEXER_HEALTH_URL=http://127.0.0.1:18711/health

# Crawler-stall threshold (seconds since the crawl loop last made
# scheduling progress). 300s = 5x the watchdog cycle, ~10x the tip-rest
# poll cadence, ~5x the max RPC-pause backoff — big margins on purpose.
# MAZA_INDEXER_STALL_SECS=300

# Optional overrides (sane in-script defaults exist for all):
# MAZA_WATCHDOG_COOLDOWN=900
# MAZA_WATCHDOG_MAX_CONSEC_HEALS=3
# MAZA_INDEXER_LAT_SAMPLES=50
