# /etc/maza-bench-watchdog.env — per-host watchdog config (deploy step writes
# this file; real values are NEVER committed). Placeholders only.
# Mode comes from the unit's ExecStart argument, so MAZA_WATCHDOG_ROLE is a
# manual-run convenience only.

# Alert destination: numeric Telegram chat id. Default is the fleet default
# (Sami's DM, same audience as the DashCaddy watchdog). Set to the MAZA
# Skunkworks group id when that id is provided.
MAZA_WATCHDOG_CHAT=637130179

# Telegram token source: a 0600 file containing ONLY the token on line 1
# (staged by the deploy step; never committed, never printed).
MAZA_WATCHDOG_TOKEN_FILE=/etc/maza-bench-watchdog.token

# Tunnel role ONLY: the local tunnel bind URL to probe (full chain through
# the ssh -L forward). No default on purpose — the bind address is
# host-specific and stays out of the repo (M19 IP hygiene).
# MAZA_TUNNEL_PROBE_URL=http://<tunnel-bind-ip>:18701/api/state

# Optional overrides (sane in-script defaults exist for all):
# MAZA_WATCHDOG_COOLDOWN=900
# MAZA_WATCHDOG_SLOW_COOLDOWN=21600
# MAZA_WATCHDOG_MAX_CONSEC_HEALS=3
# MAZA_WATCHDOG_DISK_MAX_PCT=90
