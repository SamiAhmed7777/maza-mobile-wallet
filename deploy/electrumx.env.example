# deploy/electrumx.env.example — configuration for the MAZA ElectrumX indexer.
#
# systemd path : edit, then install as /etc/electrumx-maza.env
#                (chmod 600 — DAEMON_URL carries the daemon RPC credentials).
# compose path : copy next to deploy/docker-compose.yml as deploy/electrumx.env
#                (gitignored). DAEMON_URL is NOT read from it on the compose
#                path — that value (with credentials) comes from deploy/.env
#                via compose interpolation, so the tracked compose file never
#                carries credentials; see the compose file's header.
#
# Placeholders ONLY. Never commit a copy carrying real credentials.

# --- electrumx reads these (identical to the interactive serve in Step 4) ---
# The DB lives under /var/lib; systemd's StateDirectory or the guide's
# `install -d` fence provisions it with the right owner.
DB_DIRECTORY=/var/lib/electrumx-maza
# rpcuser/rpcpass = the mazad RPC credentials from maza.conf; 12832 is
# mazad's default RPC port. Keep the daemon's RPC on loopback — NEVER point
# DAEMON_URL at a publicly reachable RPC port.
DAEMON_URL=http://rpcuser:rpcpass@127.0.0.1:12832
# The DB backend installed by the Step 3 installer (the pinned electrumx
# tree ships NO backend; leveldb = the plyvel extra it installs).
DB_ENGINE=leveldb
# Loopback-only listener. Public TLS is a root-managed proxy's job (guide
# Step 4): nginx terminates ssl:50002 and forwards to this socket.
SERVICES=tcp://127.0.0.1:50001

# --- expanded ONLY by the systemd unit's ExecStart lines ---
# Both paths must be readable by the `electrumx` service user (the guide's
# Step 4b chowns /opt/... to it). Unknown to electrumx itself; harmless in
# the compose path.
ELECTRUMX_VENV=/opt/venvs/electrumx-maza
MAZA_REPO_DIR=/opt/maza-mobile-wallet
