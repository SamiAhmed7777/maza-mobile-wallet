[Unit]
Description=MAZA wallet bench TCP tunnel (DNS2 -> samihost walletbench)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -L 100.121.150.22:18701:100.98.140.83:18701 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new -i /root/.ssh/new_server_ed25519 -o IdentitiesOnly=yes root@194.163.161.162
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
