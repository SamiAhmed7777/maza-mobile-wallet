<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mazawallet"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- S-2b-ii: platform BiometricPrompt.authenticate() requires this
         normal-level permission (auto-granted, no runtime prompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- M8b: QR scan on the SEND tab. Runtime-requested when the user taps
         Scan (ScanFlowPolicy gates the flow); the camera feed is decoded
         in memory only - no image capture, no storage. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- M14: local receive notifications. Runtime-requested once per
         session on Android 13+ (denied = no notifications, wallet
         unaffected); pre-13 APIs are pre-granted. App-alive poll scope
         only - no push (DECISIONS D16). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="MAZA Wallet"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- S-4: settings + wallet management. Not exported (no intent filter):
             reachable only from the app's own PIN-gated WALLET tab. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>

</manifest>
